# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

node_modules/
.next/
*.tsbuildinfo
.env*
!.env.example

# SQLite data for share links, tallies and suggestions (set DATA_DIR in production)
data/

# Screenshots from scripts/shot.mjs during development
.shots/
__pycache__/

# Repo skills are shared with every session; the rest of .claude stays local (global gitignore ignores .claude).
!.claude/
.claude/*
!.claude/skills/
# The central ai_docs folder belongs to this repo (the global gitignore hides ai_docs elsewhere).
!ai_docs/
