    }
    --
    state "Rest" as r1 {
      s7: Time left today
      s8: Today's minutes are up
      s9: Rest screen up
      [*] --> s7
      s7 --> s8: today's minutes run out [when You is not Looking away]
      s8 --> s9: the page reloads [when You is not Looking away]
      s9 --> s7: a grown-up gives 10 more minutes [when You is Here]
      s8 --> s9: a moment later the round ends [when Wall is Last shadow matched, next one coming and You is Here]
    }
    --
    state "You" as r2 {
      s10: Here
      s11: Looking away
      s12: Here, a level button has focus
      [*] --> s10
      s10 --> s11: you look away
      s10 --> s12: you tap a level number [when Rest is not Rest screen up]
      s11 --> s10: you come back
      s12 --> s10: the page reloads or you tap a wrong picture or you tap the right picture
      s12 --> s11: you look away
      s11 --> s12: you come back [when Wall is First shadow on the wall and Rest is not Rest screen up]
    }
