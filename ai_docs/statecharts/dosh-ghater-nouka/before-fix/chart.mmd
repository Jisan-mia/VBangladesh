      s11 --> s0: আব#2509;ব#2497;'s boat counts its ghats or you tap a mode button or a ধ#2494;প
    }
    --
    state "Window" as r1 {
      s12: You're on the page
      s13: You're away
      [*] --> s12
      s12 --> s13: you leave (another window or tab)
      s13 --> s12: you come back
    }
    --
    state "Sound" as r2 {
      s14: Sound on
      s15: Sound off
      [*] --> s14
      s14 --> s15: you turn sound off [when Race is not Rest screen after the race and Window is You're on the page]
      s15 --> s14: you turn sound on [when Race is not Rest screen after the race and Window is You're on the page]
    }
    --
    state "Today" as r3 {
      s16: Time left today
      s17: Today's time is up
      s18: Time left today, a finished race never counted
      s19: Today's time is up, a finished race never counted
      [*] --> s16
      s16 --> s17: today's time runs out [when Window is You're on the page]
      s16 --> s18: you tap a mode button or a ধ#2494;প [when Race is Your boat at the last ghat, card coming]
      s18 --> s19: today's time runs out [when Window is You're on the page]
      s17 --> s19: you tap a mode button or a ধ#2494;প [when Race is Your boat at the last ghat, card coming]
      s17 --> s16: a grown-up gives ১০ more minutes [when Race is Rest screen after the race]
      s18 --> s16: 0.9 s later the card shows [when Race is Your boat at the last ghat, card coming]
      s19 --> s17: 0.9 s later the card shows [when Race is Your boat at the last ghat, card coming]
    }
    --
    state "Gate" as r4 {
      s20: বড#2492;দ#2503;র জন#2509;য closed
